{
  "expo": {
    "name": "ProBoxerTimmer",
    "slug": "pro-boxer-timmer",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "platforms": ["android", "ios"],
    "ios": {
      "bundleIdentifier": "com.henbryant.proboxertimmer",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.henbryant.proboxertimmer"
    },
    "plugins": [
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false }]
    ]
  }
}
